{
  "name": "dk-industry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "concurrently \"npm start --prefix frontend\" \"npm run dev --prefix backend\"",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev": "concurrently \"npm start --prefix frontend\" \"npm run dev --prefix backend\"",
    "frontend": "npm start --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "check:architecture": "depcruise frontend/src backend/src --config .dependency-cruiser.cjs",
    "validate:workflows": "node scripts/validate-workflows.js",
    "test:backend:ci": "node scripts/run-backend-ci-tests.js",
    "check:push": "node scripts/pre-push-check.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "prepare": "node scripts/install-git-hooks.js",
    "check": "npm run lint --prefix frontend && npm test --prefix frontend && npm test --prefix backend && npm run test:preflight && npm run test:backup-security && npm run test:deployment-security && npm run build --prefix frontend && npm run scan:client-bundle && npm run test:e2e --prefix frontend",
    "test:preflight": "node --test scripts/preflight.test.js",
    "test:backup-security": "node --test scripts/backup-security.test.js",
    "test:deployment-security": "node --test scripts/deployment-security.test.js",
    "scan:client-bundle": "node scripts/check-client-bundle.js",
    "preflight:production": "node scripts/preflight.js",
    "smoke:production": "node scripts/smoke-production.js",
    "smoke:roles": "node scripts/smoke-roles.js",
    "audit:prod": "npm audit --omit=dev --prefix backend && npm audit --omit=dev --prefix frontend",
    "backup:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-mongodb.ps1",
    "verify:integrations": "npm run verify:integrations --prefix backend",
    "setup:mfa-key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-mfa-key.ps1",
    "seed": "npm run seed --prefix backend",
    "seed:admin": "npm run seed:admin --prefix backend",
    "migrate:lead-service": "npm run migrate:lead-service --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.7.0",
    "typescript": "~5.9.3"
  }
}
