# Docker Compose interpolation only; this file contains no application secrets.
# Recommended when Caddy/Nginx/Traefik runs on the same host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# If the TLS proxy is on another private host, use the origin's private
# interface address instead. Do not use 0.0.0.0 until the firewall restricts
# ingress to the proxy/Cloudflare ranges and direct-origin access is tested.
