    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "socket.io-client": "^4.8.1"
