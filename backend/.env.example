# Local MongoDB (use this for a database stored only on this computer)
MONGODB_URI=mongodb://127.0.0.1:27017/dk_industry

# MongoDB Atlas example (recommended for shared development and deployment)
# MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster_host>/dk_industry?retryWrites=true&w=majority
# Integration tests never use MONGODB_URI. Point this to a disposable database whose name ends in _test.
# TEST_MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster_host>/dk_industry_test?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
TERMS_VERSION=2026-10-12
CLIENT_URL=http://localhost:3000
JWT_SECRET=replace_with_a_cryptographically_random_secret_of_at_least_48_characters
MFA_ENCRYPTION_KEY=replace_with_a_separate_random_secret_of_at_least_32_characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
MONGODB_POOL_SIZE=10
MONGODB_SELECTION_TIMEOUT_MS=10000
SERVER_SHUTDOWN_TIMEOUT_MS=10000

# File storage: local for development; use cloudinary before production/deployment.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=./storage
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET separately.
# Production refuses local storage unless this explicit exception is true.
ALLOW_LOCAL_FILE_STORAGE=false

# Gmail SMTP (requires 2-Step Verification and a dedicated App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=replace_with_a_new_16_character_app_password
EMAIL_FROM="Cơ khí Đăng Khoa <your_gmail_address@gmail.com>"
SMTP_TEST_TO=your_gmail_address@gmail.com

# Production hardening
# Production requires MongoDB replica set/sharded cluster. Keep false unless accepting weaker local-only writes.
ALLOW_NON_TRANSACTIONAL_WRITES=false
# Set to the number of trusted reverse proxies (usually 1) when deployed behind Nginx/Cloudflare/load balancer.
TRUST_PROXY=1
# Check that every access token still belongs to an active server-side session.
ENFORCE_SESSION_CHECK=true
ADMIN_SEED_NAME=Quản trị Đăng Khoa
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PHONE=0900000000
ADMIN_SEED_PASSWORD=replace_with_a_secure_admin_password
# OpenStreetMap/Nominatim: no API key or billing account is required.
# Keep a real contact email so the public service operator can identify this application.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=your_contact_email@example.com

# AI customer support (Groq free tier)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_key_cua_ban
SUPPORT_AI_ENABLED=true
AI_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
