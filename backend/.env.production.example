# Copy to backend/.env.production. Never commit the completed file.
NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0
RELEASE_SHA=replace_with_git_commit_sha
MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster>/dk_industry?retryWrites=true&w=majority
CLIENT_URL=https://your-production-domain.example
JWT_SECRET=replace_with_a_random_secret_of_at_least_48_characters
MFA_ENCRYPTION_KEY=replace_with_a_different_random_secret_of_at_least_32_characters
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
ENFORCE_SESSION_CHECK=true
ALLOW_NON_TRANSACTIONAL_WRITES=false
MONGODB_POOL_SIZE=10
MONGODB_SELECTION_TIMEOUT_MS=10000
SERVER_SHUTDOWN_TIMEOUT_MS=10000

FILE_STORAGE_DRIVER=cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_production_email@example.com
SMTP_PASS=replace_with_a_dedicated_app_password
EMAIL_FROM="DK Industry <your_production_email@example.com>"
SMTP_TEST_TO=your_operations_email@example.com
EMAIL_MAX_ATTEMPTS=5

# Address search uses the public Nominatim service without an API key.
COMPANY_NAME=your_legal_or_trading_name
COMPANY_PHONE=your_phone_digits
COMPANY_EMAIL=your_public_contact_email@example.com
COMPANY_ADDRESS=your_public_business_address
COMPANY_PHONE_LABEL=your_display_phone_number
COMPANY_LOGO_URL=https://your-public-cdn.example/logo.png
COMPANY_ZALO_URL=https://zalo.me/your_zalo_phone_or_oa_id
EMAIL_BRAND_NAME=your_short_brand_name
TERMS_VERSION=2026-10-14

SUPPORT_AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_key
AI_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Use only for the one-time bootstrap, then remove it from the runtime environment.
ADMIN_SEED_NAME=Quản trị DK Industry
ADMIN_SEED_EMAIL=your_admin_email@example.com
ADMIN_SEED_PHONE=your_admin_phone
ADMIN_SEED_PASSWORD=replace_with_a_temporary_strong_password
