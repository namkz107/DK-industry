# Copy to frontend/.env.production before building the web image.
# Same-origin API/WebSocket works with the included Nginx config.
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_SITE_URL=https://your-production-domain.example
VITE_POLICY_VERSION=2026-10-12

VITE_CLOUDINARY_LOGO_URL=https://res.cloudinary.com/your_cloud_name/image/upload/f_auto,q_auto/your_logo_public_id
VITE_CLOUDINARY_CEO_IMAGE_URL=https://res.cloudinary.com/your_cloud_name/image/upload/f_auto,q_auto/dk-industry/ceo-founder

VITE_COMPANY_NAME=your_legal_or_trading_name
VITE_COMPANY_PHONE=your_phone_digits
VITE_COMPANY_PHONE_LABEL=your_display_phone_number
VITE_COMPANY_EMAIL=your_public_contact_email@example.com
VITE_COMPANY_ADDRESS=your_public_business_address
VITE_COMPANY_MAP_DESTINATION=20.895803,105.862915
VITE_COMPANY_TAX_CODE=your_company_tax_code
VITE_COMPANY_REGISTRATION_NUMBER=your_business_registration_number
VITE_COMPANY_LEGAL_REPRESENTATIVE=your_legal_representative
